package ndarray;

use std::math;

pub struct Qr {
    factors: Array[f64],
    tau: Vec[f64],
}

fn reflected_value(value: f64, factor: f64, dot: f64, scale: f64) -> f64 {
    let change = factor * dot;
    if magnitude(change) < float64_from_bits(0x0010000000000000) {
        // Restore the scale before multiplying a tiny reflector component so
        // a subnormal product does not lose precision in scaled coordinates.
        value - (factor * scale) * dot
    } else {
        (value / scale - change) * scale
    }
}

fn apply_householder(
    factors: Vec[f64],
    factor_columns: isize,
    target: Vec[f64],
    target_columns: isize,
    first: isize,
    rows: isize,
    column: isize,
    coefficient: f64,
) -> () {
    let leading = first * target_columns + column;
    let mut dot = target[leading];
    for row in first + 1..rows {
        dot += factors[row * factor_columns + first] * target[row * target_columns + column];
    }
    dot *= coefficient;
    if math::is_finite(dot) {
        target[leading] -= dot;
        for row in first + 1..rows {
            target[row * target_columns + column] -= factors[row * factor_columns + first] * dot;
        }
    } else {
        // The reflector coefficient can overflow the dot product even when every
        // reflected component fits. Retry in power-of-two scaled coordinates.
        let mut largest = magnitude(target[leading]);
        for row in first + 1..rows {
            if factors[row * factor_columns + first] != 0.0 {
                let value = magnitude(target[row * target_columns + column]);
                if value > largest {
                    largest = value;
                }
            }
        }
        let scale = float64_from_bits(float64_to_bits(largest) & 0x7ff0000000000000);
        let mut scaled_dot = target[leading] / scale;
        for row in first + 1..rows {
            let factor = factors[row * factor_columns + first];
            if factor != 0.0 {
                scaled_dot += factor * (target[row * target_columns + column] / scale);
            }
        }
        scaled_dot *= coefficient;
        target[leading] = reflected_value(target[leading], 1.0, scaled_dot, scale);
        for row in first + 1..rows {
            let factor = factors[row * factor_columns + first];
            if factor != 0.0 {
                let index = row * target_columns + column;
                target[index] = reflected_value(target[index], factor, scaled_dot, scale);
            }
        }
    }
}

impl Array[f64] {
    pub fn qr(self: Array[f64], options: SolveOptions) -> Result[Qr, Error] {
        let (rows, columns, data) = matrix_values(self, false)?;
        if rows < columns {
            return Result::Err(
                Error::new(ErrorKind::Shape, "QR requires at least as many rows as columns"),
            )
        }
        let tolerance = options.threshold(data)?;
        let tau = Vec::with_capacity(columns);
        for k in 0..columns {
            let tail = Vec::new();
            for row in k..rows {
                tail.push(data[row * columns + k]);
            }
            let norm = stable_norm(tail.as_slice());
            if !math::is_finite(norm) {
                return Result::Err(Error::new(ErrorKind::NonFinite, "QR column norm overflow"))
            }
            if norm <= tolerance {
                return Result::Err(
                    Error::new(
                        ErrorKind::Singular,
                        "matrix does not have full column rank at the requested tolerance",
                    ),
                )
            }
            let leading = data[k * columns + k];
            let beta = if leading >= 0.0 {
                -norm
            } else {
                norm
            };
            let coefficient = 1.0 - leading / beta;
            let denominator = leading / norm - beta / norm;
            tau.push(coefficient);
            for row in k + 1..rows {
                data[row * columns + k] = (data[row * columns + k] / norm) / denominator;
            }
            data[k * columns + k] = beta;
            for column in k + 1..columns {
                apply_householder(data, columns, data, columns, k, rows, column, coefficient);
            }
            finite_values(data)?;
        }
        Result::Ok(Qr { factors: owned(self.dimensions, data, self.limits), tau })
    }

    pub fn least_squares(self: Array[f64], rhs: Array[f64], options: SolveOptions) -> Result[
        Array[f64],
        Error,
    ] {
        self.qr(options)?.solve(rhs)
    }
}

impl Qr {
    pub fn q(self: Qr) -> Array[f64] {
        let rows = self.factors.dimensions[0];
        let columns = self.factors.dimensions[1];
        let data = zeros(rows * columns);
        for index in 0..columns {
            data[index * columns + index] = 1.0;
        }
        let mut k = columns;
        while k > 0 {
            k -= 1;
            for column in 0..columns {
                apply_householder(
                    self.factors.data,
                    columns,
                    data,
                    columns,
                    k,
                    rows,
                    column,
                    self.tau[k],
                );
            }
        }
        owned(self.factors.dimensions, data, self.factors.limits)
    }

    pub fn r(self: Qr) -> Array[f64] {
        let columns = self.factors.dimensions[1];
        let data = zeros(columns * columns);
        for row in 0..columns {
            for column in row..columns {
                data[row * columns + column] = self.factors.data[row * columns + column];
            }
        }
        owned(Vec::from_array([columns, columns]), data, self.factors.limits)
    }

    pub fn solve(self: Qr, rhs: Array[f64]) -> Result[Array[f64], Error] {
        let rows = self.factors.dimensions[0];
        let columns = self.factors.dimensions[1];
        let (count, vector, data) = rhs_values(rhs, rows)?;
        let shape = if vector {
            Vec::from_array([columns])
        } else {
            Vec::from_array([columns, count])
        };
        let limits = self.factors.limits.intersect(rhs.limits);
        let _ = shape_size(shape, limits)?;
        for k in 0..columns {
            for j in 0..count {
                apply_householder(self.factors.data, columns, data, count, k, rows, j, self.tau[k]);
            }
        }
        let result = data.slice(0, columns * count).to_vec();
        let mut row = columns;
        while row > 0 {
            row -= 1;
            for later in row + 1..columns {
                for j in 0..count {
                    result[row * count + j] -= self.factors.data[row * columns + later]
                        * result[later * count + j];
                }
            }
            for j in 0..count {
                result[row * count + j] /= self.factors.data[row * columns + row];
            }
        }
        finite_values(result)?;
        Result::Ok(owned(shape, result, limits))
    }
}
