package ndarray;

use std::math;

fn mean_values(values: Slice[f64]) -> Result[f64, Error] {
    if values.len() == 0 {
        return Result::Err(Error::new(ErrorKind::Empty, "mean requires at least one value"))
    }
    let total = compensated_sum(values);
    if math::is_finite(total) {
        return Result::Ok(total / count_float(values.len()))
    }
    for value in values {
        if !math::is_finite(value) {
            return Result::Ok(total / count_float(values.len()))
        }
    }
    let count = count_float(values.len());
    // Scaling by sample count bounds the sum without erasing small terms
    // that remain after cancellation between extremely large observations.
    let mut scale = 2.0;
    while scale < 2.0 * count {
        scale *= 2.0;
    }
    let normalized = Vec::with_capacity(values.len());
    let residuals = Vec::new();
    for value in values {
        let scaled = value / scale;
        normalized.push(scaled);
        let residual = value - scaled * scale;
        if residual != 0.0 {
            residuals.push(residual);
        }
    }
    let (sum, correction) = compensated_sum_parts(normalized.as_slice());
    let restored = (sum + correction) * scale;
    // Restore tiny sums and scaling underflow before division. For large sums,
    // divide the compensation separately to avoid premature restoration overflow.
    let mean = if math::is_finite(restored) {
        let corrected = restored + compensated_sum(residuals.as_slice());
        corrected / count
    } else {
        let divided = sum / count + correction / count;
        divided * scale
    };
    Result::Ok(mean)
}

fn variance_values(values: Slice[f64], ddof: isize) -> Result[f64, Error] {
    if ddof < 0 {
        return Result::Err(
            Error::new(ErrorKind::Arithmetic, "degrees of freedom must be nonnegative"),
        )
    }
    if values.len() <= ddof {
        return Result::Err(
            Error::new(ErrorKind::Empty, "variance has no remaining degrees of freedom"),
        )
    }
    let variance = scaled_variance(values, ddof, 1.0);
    if math::is_finite(variance) {
        return Result::Ok(variance)
    }
    let mut scale = 0.0;
    for value in values {
        if !math::is_finite(value) {
            return Result::Ok(variance)
        }
        if magnitude(value) > scale {
            scale = magnitude(value);
        }
    }
    Result::Ok(scaled_variance(values, ddof, scale))
}

fn scaled_variance(values: Slice[f64], ddof: isize, scale: f64) -> f64 {
    normalized_variance(values, ddof, scale) * scale * scale
}

fn normalized_variance(values: Slice[f64], ddof: isize, scale: f64) -> f64 {
    let origin = values[0];
    let mut mean = 0.0;
    let mut squares = 0.0;
    let mut count = 0;
    for original in values {
        // Center before scaling so a large common offset cannot round away
        // the spread. Only scale first when the subtraction itself overflows.
        let difference = original - origin;
        let value = if math::is_finite(difference) {
            difference / scale
        } else {
            original / scale - origin / scale
        };
        count += 1;
        let delta = value - mean;
        mean += delta / count_float(count);
        squares += delta * (value - mean);
    }
    squares / count_float(values.len() - ddof)
}

fn stddev_values(values: Slice[f64], ddof: isize) -> Result[f64, Error] {
    let variance = variance_values(values, ddof)?;
    if math::is_finite(variance) && variance >= float64_from_bits(0x0010000000000000) {
        return Result::Ok(math::sqrt(variance))
    }
    let mut scale = 0.0;
    for value in values {
        if !math::is_finite(value) {
            return Result::Ok(math::sqrt(variance))
        }
        if magnitude(value) > scale {
            scale = magnitude(value);
        }
    }
    if scale == 0.0 {
        return Result::Ok(0.0)
    }
    Result::Ok(math::sqrt(normalized_variance(values, ddof, scale)) * scale)
}

fn extreme_index(values: Slice[f64], maximum: bool) -> Result[isize, Error] {
    if values.len() == 0 {
        return Result::Err(Error::new(ErrorKind::Empty, "extrema require at least one value"))
    }
    let mut best = 0;
    for index in 0..values.len() {
        if math::is_nan(values[index]) {
            return Result::Ok(index)
        }
        if if maximum {
            values[index] > values[best]
        } else {
            values[index] < values[best]
        } {
            best = index;
        }
    }
    Result::Ok(best)
}

fn stable_norm(values: Slice[f64]) -> f64 {
    let mut scale = 0.0;
    let mut infinite = false;
    for value in values {
        if math::is_nan(value) {
            return value
        }
        if math::is_infinite(value) {
            infinite = true;
        }
        if magnitude(value) > scale {
            scale = magnitude(value);
        }
    }
    if infinite {
        return float64_from_bits(0x7ff0000000000000)
    }
    if scale == 0.0 {
        return 0.0
    }
    let mut sum = 0.0;
    let mut correction = 0.0;
    for value in values {
        let normalized = value / scale;
        let square = normalized * normalized;
        let next = sum + square;
        correction += if sum >= square {
            (sum - next) + square
        } else {
            (square - next) + sum
        };
        sum = next;
    }
    scale * math::sqrt(sum + correction)
}

pub fn linspace(start: f64, end: f64, count: isize, endpoint: bool) -> Result[Array[f64], Error] {
    Array::[f64]::linspace(start, end, count, endpoint)
}

impl Array[f64] {
    pub fn linspace(start: f64, end: f64, count: isize, endpoint: bool) -> Result[Array[f64], Error] {
        if !math::is_finite(start) || !math::is_finite(end) {
            return Result::Err(
                Error::new(ErrorKind::NonFinite, "linspace requires finite endpoints"),
            )
        }
        let shape = Vec::from_array([count]);
        let _ = shape_size(shape, Limits::standard())?;
        let values = Vec::with_capacity(count);
        for index in 0..count {
            let weight = if count <= 1 {
                0.0
            } else {
                count_float(index)
                    / count_float(
                        if endpoint {
                            count - 1
                        } else {
                            count
                        },
                    )
            };
            values.push(
                if index == 0 {
                    start
                } else if endpoint && index == count - 1 {
                    end
                } else if start == end {
                    start
                } else if magnitude(start) < float64_from_bits(0x0010000000000000)
                    && magnitude(end) < float64_from_bits(0x0010000000000000) {
                    // Defer rounding subnormal products until after interpolation.
                    let scale = 4503599627370496.0;
                    ((1.0 - weight) * (start * scale) + weight * (end * scale)) / scale
                } else {
                    (1.0 - weight) * start + weight * end
                },
            );
        }
        Result::Ok(owned(shape, values, Limits::standard()))
    }

    pub fn mean(self: Array[f64]) -> Result[f64, Error] {
        mean_values(self.to_vec().as_slice())
    }

    pub fn variance(self: Array[f64], ddof: isize) -> Result[f64, Error] {
        variance_values(self.to_vec().as_slice(), ddof)
    }

    pub fn stddev(self: Array[f64], ddof: isize) -> Result[f64, Error] {
        stddev_values(self.to_vec().as_slice(), ddof)
    }

    pub fn minimum(self: Array[f64]) -> Result[f64, Error] {
        let values = self.to_vec();
        Result::Ok(values[extreme_index(values.as_slice(), false)?])
    }

    pub fn maximum(self: Array[f64]) -> Result[f64, Error] {
        let values = self.to_vec();
        Result::Ok(values[extreme_index(values.as_slice(), true)?])
    }

    pub fn argmin(self: Array[f64]) -> Result[isize, Error] {
        extreme_index(self.to_vec().as_slice(), false)
    }

    pub fn argmax(self: Array[f64]) -> Result[isize, Error] {
        extreme_index(self.to_vec().as_slice(), true)
    }

    pub fn norm(self: Array[f64]) -> f64 {
        stable_norm(self.to_vec().as_slice())
    }

    pub fn mean_axes(self: Array[f64], axes: Vec[isize], keep_dimensions: bool) -> Result[
        Array[f64],
        Error,
    ] {
        self.reduce_axes(axes, keep_dimensions, |values| mean_values(values))
    }

    pub fn variance_axes(self: Array[f64], axes: Vec[isize], keep_dimensions: bool, ddof: isize) -> Result[
        Array[f64],
        Error,
    ] {
        if ddof < 0 {
            return Result::Err(
                Error::new(ErrorKind::Arithmetic, "degrees of freedom must be nonnegative"),
            )
        }
        self.reduce_axes(axes, keep_dimensions, |values| variance_values(values, ddof))
    }

    pub fn stddev_axes(self: Array[f64], axes: Vec[isize], keep_dimensions: bool, ddof: isize) -> Result[
        Array[f64],
        Error,
    ] {
        if ddof < 0 {
            return Result::Err(
                Error::new(ErrorKind::Arithmetic, "degrees of freedom must be nonnegative"),
            )
        }
        self.reduce_axes(axes, keep_dimensions, |values| stddev_values(values, ddof))
    }

    pub fn min_axes(self: Array[f64], axes: Vec[isize], keep_dimensions: bool) -> Result[
        Array[f64],
        Error,
    ] {
        self.reduce_axes(
            axes,
            keep_dimensions,
            |values| Result::Ok(values[extreme_index(values, false)?]),
        )
    }

    pub fn max_axes(self: Array[f64], axes: Vec[isize], keep_dimensions: bool) -> Result[
        Array[f64],
        Error,
    ] {
        self.reduce_axes(
            axes,
            keep_dimensions,
            |values| Result::Ok(values[extreme_index(values, true)?]),
        )
    }

    pub fn argmin_axis(self: Array[f64], axis: isize, keep_dimensions: bool) -> Result[
        Array[isize],
        Error,
    ] {
        self.reduce_axes(
            Vec::from_array([axis]),
            keep_dimensions,
            |values| extreme_index(values, false),
        )
    }

    pub fn argmax_axis(self: Array[f64], axis: isize, keep_dimensions: bool) -> Result[
        Array[isize],
        Error,
    ] {
        self.reduce_axes(
            Vec::from_array([axis]),
            keep_dimensions,
            |values| extreme_index(values, true),
        )
    }

    pub fn sqrt(self: Array[f64]) -> Array[f64] {
        self.map(|value| math::sqrt(value))
    }

    pub fn exp(self: Array[f64]) -> Array[f64] {
        self.map(|value| math::exp(value))
    }

    pub fn log(self: Array[f64]) -> Array[f64] {
        self.map(|value| math::log(value))
    }

    pub fn abs(self: Array[f64]) -> Array[f64] {
        self.map(|value| magnitude(value))
    }

    pub fn negate(self: Array[f64]) -> Array[f64] {
        self.map(|value| -value)
    }

    pub fn pow(self: Array[f64], exponent: f64) -> Array[f64] {
        self.map(|value| math::pow(value, exponent))
    }

    pub fn is_finite(self: Array[f64]) -> Array[bool] {
        self.map(|value| math::is_finite(value))
    }

    pub fn is_nan(self: Array[f64]) -> Array[bool] {
        self.map(|value| math::is_nan(value))
    }

    pub fn equal(self: Array[f64], other: Array[f64]) -> Result[Array[bool], Error] {
        self.zip_map(other, |a, b| a == b)
    }

    pub fn less(self: Array[f64], other: Array[f64]) -> Result[Array[bool], Error] {
        self.zip_map(other, |a, b| a < b)
    }

    pub fn clip(self: Array[f64], lower: f64, upper: f64) -> Result[Array[f64], Error] {
        if math::is_nan(lower) || math::is_nan(upper) || lower > upper {
            return Result::Err(Error::new(ErrorKind::Arithmetic, "invalid clipping interval"))
        }
        Result::Ok(
            self.map(
                |value| if value < lower {
                    lower
                } else if value > upper {
                    upper
                } else {
                    value
                },
            ),
        )
    }

    pub fn all_close(
        self: Array[f64],
        other: Array[f64],
        relative: f64,
        absolute: f64,
        equal_nan: bool,
    ) -> Result[bool, Error] {
        if relative < 0.0 || absolute < 0.0 || !math::is_finite(relative)
            || !math::is_finite(absolute) {
            return Result::Err(
                Error::new(ErrorKind::Arithmetic, "tolerances must be finite and nonnegative"),
            )
        }
        Result::Ok(
            self.zip_map(
                other,
                |a, b| {
                    if a == b {
                        true
                    } else if math::is_nan(a) || math::is_nan(b) {
                        equal_nan && math::is_nan(a) && math::is_nan(b)
                    } else if !math::is_finite(a) || !math::is_finite(b) {
                        false
                    } else {
                        let distance = magnitude(a - b);
                        let tolerance = absolute + relative * magnitude(b);
                        if math::is_infinite(distance) && math::is_infinite(tolerance) {
                            // Both operands are finite; comparing two overflows would
                            // accept every distance, even one exceeding the tolerance.
                            // Halving the operands makes their distance representable.
                            magnitude(a * 0.5 - b * 0.5)
                                <= absolute * 0.5 + (relative * 0.5) * magnitude(b)
                        } else {
                            distance <= tolerance
                        }
                    }
                },
            )?.all(),
        )
    }
}
